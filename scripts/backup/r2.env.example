# Cloudflare R2 settings for r2-upload.sh (on the database host) and r2-fetch.sh (on the restoring machine).
# Copy to a file only its owner reads (chmod 600). The two hosts use DIFFERENT tokens:
#   the database host:      an "Object Read & Write" token scoped to this one bucket
#   the restoring machine:  an "Object Read only" token scoped to this one bucket
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=smilesim
# R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com    # only for a bucket made in a jurisdiction
