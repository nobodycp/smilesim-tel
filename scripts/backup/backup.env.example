# Settings of scripts/backup/backup.sh on the host that runs the database. Copy to a file only root reads
# (chmod 600) and fill in. Nothing here is a secret that opens a backup: the host holds the PUBLIC key only.
BACKUP_PG_CONTAINER=            # the postgres container's name (docker ps)
BACKUP_PUBLIC_KEY=/etc/smilesim-backup/backup-public.asc
BACKUP_DIR=/var/backups/smilesim
BACKUP_UPLOAD_CMD=/etc/smilesim-backup/upload.sh   # `upload.sh <file> <manifest>`: exit 0 only when both are off this host
BACKUP_KEEP_LOCAL=7
BACKUP_MIN_FREE_MB=2048
BACKUP_FINGERPRINT=full         # counts, once hashing every table each night costs too much
