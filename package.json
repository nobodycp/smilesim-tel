{
  "name": "smilesim-tel",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces",
    "check:copy": "npm run check:copy --workspace web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "npm run test:api",
    "test:api": "npm test --workspace api",
    "test:e2e": "npm test --workspace web",
    "build": "npm run build --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace api"
  }
}
