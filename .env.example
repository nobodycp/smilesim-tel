# Copy to .env for local runs. .env is git-ignored; never commit real values.
# `docker compose up` reads .env from this folder. Every value below has a working default,
# so you can skip the file entirely for a plain local start.

# ---- api (apps/api) -------------------------------------------------------------------------
# PostgreSQL connection string. The default matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://smilesim:smilesim@postgres:5432/smilesim
# Redis (sessions, login-failure counter, BullMQ queues).
REDIS_URL=redis://redis:6379
# Port the api listens on when run outside docker (default 3001).
# PORT=3001

# The one browser origin the api allows (CORS with cookies). Local: the web app on :3000.
# Production: the public web URL, for example https://app.example.com
WEB_ORIGIN=http://localhost:3000
# Cookies are sent only over https when true. Must be true in production.
COOKIE_SECURE=false
# Parent domain shared by web and api so one cookie covers the four doors
# (for example example.com). Leave empty locally.
COOKIE_DOMAIN=

# ---- web (apps/web) -------------------------------------------------------------------------
# Public api URL. A BUILD argument of the web image: it is inlined at build time, so changing it
# means rebuilding web. Local: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Where the Next dev/build rewrite of /api/* points. Falls back to NEXT_PUBLIC_API_URL, then
# http://127.0.0.1:3001. Also frozen at build time.
# API_PROXY_URL=http://127.0.0.1:3001
# Alternative build output folder, so a throwaway build does not touch a running dev server.
# NEXT_DIST_DIR=.next

# ---- trial accounts -------------------------------------------------------------------------
# The trial accounts branch / main / agent / pos share the PUBLISHED password 123456 (this
# repository is public). They are created at api start-up only when the users table is empty
# AND TRIAL_SEED is true. They are meant for a local database and nothing else.
#
# Local `docker compose up` turns them on through docker-compose.override.yml. Uncomment a line
# here only to change that (for example TRIAL_SEED=false to start with no accounts).
# Production must leave both unset. The api image runs with NODE_ENV=production, so
# TRIAL_SEED=true is ignored there unless TRIAL_SEED_ALLOW_PRODUCTION=true is also set on purpose.
# With the seed closed and an empty table, the api starts, creates nothing, and logs a warning.
# TRIAL_SEED=true
# TRIAL_SEED_ALLOW_PRODUCTION=false

# ---- tests (apps/web, Playwright) ------------------------------------------------------------
# Set by the test config itself; listed here so the names are not a surprise.
# MOCK_API_PORT=3911
# MOCK_WEB_ORIGIN=http://pos.localhost:3910
# CI=true
