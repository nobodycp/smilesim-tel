generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String           @id @default(uuid())
  loginName              String           @unique
  nickname               String
  email                  String?
  phone                  String?
  city                   String?
  address                String?
  passwordHash           String
  mustChangePassword     Boolean          @default(false)
  layer                  String
  parentId               String?
  parent                 User?            @relation("UserTree", fields: [parentId], references: [id])
  children               User[]           @relation("UserTree")
  isBranchOwner          Boolean          @default(false)
  roleId                 String?
  role                   Role?            @relation(fields: [roleId], references: [id])
  liveGrants             String           @default("")
  extraGrants            String           @default("")
  deniedGrants           String           @default("")
  deniedOps              String           @default("")
  extraRoles             UserRole[]
  disabledAt             DateTime?
  twoFactorExempt        Boolean          @default(false)
  twoFactorEnabled       Boolean          @default(false)
  twoFactorSecret        String?
  pendingTwoFactorSecret String?
  /** How the second factor is proven: app (default), sms or email (roadmap N9). */
  twoFactorMethod        String           @default("app")
  /// Sessions allowed and idle minutes for this account; null follows its layer.
  maxSessions            Int?
  sessionMinutes         Int?
  passkeys               Passkey[]
  sessions               Session[]
  wallet                 Wallet?
  walletEntries          WalletEntry[]    @relation("WalletOwner")
  actedEntries           WalletEntry[]    @relation("WalletActor")
  posLines               Line[]           @relation("LinePos")
  submittedTasks         OfficeTask[]     @relation("TaskSubmitter")
  assignedTasks          OfficeTask[]     @relation("TaskAssignee")
  taskNotes              OfficeTaskNote[]
  notices                Notice[]
  accessLogs             AccessLog[]
  packageTerms           UserPackage[]
  sellPrices             SellPrice[]
  activityEvents         ActivityEvent[]

  // Tree walks: children of an account.
  @@index([parentId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  userAgent  String
  ip         String
  scope      String
  kind       String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
}

model Role {
  id         String     @id @default(uuid())
  name       String
  read       Boolean    @default(true)
  edit       Boolean    @default(false)
  accounting Boolean    @default(false)
  tasks      Boolean    @default(false)
  reports    Boolean    @default(false)
  staff      Boolean    @default(false)
  enter      Boolean    @default(false)
  kind       String     @default("job")
  layer      String?    @unique
  grants     String     @default("")
  users      User[]
  holders    UserRole[]
  updatedAt  DateTime   @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model LayerPolicy {
  id       String  @id @default(uuid())
  layer    String  @unique
  required Boolean @default(false)
  /// Sessions allowed and idle minutes for the layer; null follows the default (session rules spec).
  maxSessions    Int?
  sessionMinutes Int?
}

model Wallet {
  userId  String @id
  user    User   @relation(fields: [userId], references: [id])
  balance Int    @default(0)
  ceiling Int    @default(0)
  /** Money held for open tasks: not spendable until they close (roadmap N6). */
  held    Int    @default(0)
}

model WalletEntry {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("WalletOwner", fields: [userId], references: [id])
  actorId      String
  actor        User      @relation("WalletActor", fields: [actorId], references: [id])
  amount       Int
  balanceAfter Int
  kind         String
  note         String?
  msisdn       String?
  lineId       String?
  companyName  String?
  packageName  String?
  packagePrice Int?
  providerCost Int?
  /** The eSIM fee folded into `amount`, when this entry sold or issued one. */
  esimPrice    Int?
  periodDays   Int?
  periodEndsAt DateTime?
  /** A sale's price chain at the time (profit-ladder.ts `Ladder`): what each layer paid and the sell price. */
  ladder       Json?
  /** Why a manual movement was made: deposit, return, correction or settlement. */
  reason       String?
  /** For a hold or a release: the amount held (positive) or released (negative). */
  held         Int?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([lineId])
  // Reports and the line card read entries by kind, newest first.
  @@index([kind, createdAt])
}

model Provider {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  actionModes Json            @default("{}")
  esimPrice   Int?
  /** How far we may owe this provider, in agorot (roadmap N7). */
  creditLimit Int             @default(0)
  /** Which statement columns hold the number, date, amount and reference (roadmap N8). */
  statementMap Json?
  /** Alert when the available balance falls under this, in agorot (spec 2026-11-08-overview-and-reports-nav, G). */
  alertFloor  Int             @default(0)
  /** Last known status, `working` or `problem`, so a change writes its notice once. */
  health      String          @default("working")
  healthReason String?
  healthAt    DateTime?
  /** `api`: each operation matched at once; `statement`: matched every `matchEveryDays` (simulated for now, spec E). */
  matchSource    String       @default("statement")
  matchEveryDays Int          @default(7)
  lastMatchedAt  DateTime?
  /** When «مطابقة متأخرة» was sent for this lapse; cleared once the provider is matched again. */
  matchOverdueNoticeAt DateTime?
  packages    Package[]
  entries     ProviderEntry[]
  reconciliations ProviderReconciliation[]
}

/** A payment to a provider or a settlement with it (roadmap N7). Purchases come from our operations' provider cost. */
model ProviderEntry {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  /** `payment` (positive) or `settlement` (positive or negative). */
  kind       String
  amount     Int
  note       String
  actorLogin String
  createdAt  DateTime @default(now())

  @@index([providerId, createdAt])
}

model Company {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  image       String?
  iccidLength Int?
  iccidPrefix String?
  esim        Boolean   @default(true)
  esimPrice   Int       @default(500)
  packages    Package[]
}

model Package {
  id                     String           @id @default(uuid())
  code                   String           @unique
  name                   String
  providerId             String
  provider               Provider         @relation(fields: [providerId], references: [id])
  companyId              String?
  // RESTRICT as the database has it since 20261030010000_catalog: a company with packages cannot be deleted.
  company                Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  dataGb                 Int?
  /// Package details (spec 2026-11-08-branch-packages-and-details): null = not stated, -1 = unlimited.
  smsCount               Int?
  minutes                Int?
  details                String?
  /// Days after the subscription ends before the line counts as suspended (spec 2026-11-08-overview-and-reports-nav, I).
  suspendAfterDays       Int      @default(90)
  /// Whether this package may be sold or served as an eSIM; the company must allow it too (spec 2026-11-09, 5).
  esimAvailable          Boolean  @default(true)
  months                 Int              @default(1)
  branchCost             Int
  mainPrice              Int
  agentPrice             Int
  posPrice               Int
  subscriberPrice        Int
  forSale                Boolean          @default(true)
  renewalBranchCost      Int
  renewalMainPrice       Int
  renewalAgentPrice      Int
  renewalPosPrice        Int
  renewalSubscriberPrice Int
  autoActivate           Boolean
  autoCharge             Boolean
  autoDisconnect         Boolean
  autoFreeze             Boolean
  autoSwitch             Boolean
  autoExtend             Boolean          @default(false)
  autoRename             Boolean          @default(false)
  autoSim                Boolean          @default(false)
  allowActivate          Boolean          @default(true)
  allowCharge            Boolean          @default(true)
  allowDisconnect        Boolean          @default(true)
  allowFreeze            Boolean          @default(true)
  allowSwitch            Boolean          @default(true)
  allowExtend            Boolean          @default(true)
  allowRename            Boolean          @default(true)
  allowSim               Boolean          @default(true)
  enabled                Boolean          @default(true)
  actionModes            Json             @default("{}")
  /// The actions whose run mode follows the provider (spec 2026-11-09-admin-review, 3): the stored mode is the
  /// provider's, written again whenever the provider changes it. Empty = every mode is the package's own.
  inheritedModes         String[]         @default([])
  /// The provider's own product this package was added from; one package per product and provider.
  providerProductCode    String?
  esimPrice              Int?
  lines                  Line[]
  userTerms              UserPackage[]
  sellPrices             SellPrice[]
  renewals               PackageRenewal[]
  renewalTargets         PackageRenewal[] @relation("RenewalTarget")
  switches               PackageSwitch[]
  switchTargets          PackageSwitch[]  @relation("SwitchTarget")
  addons                 PackageAddon[]

  @@unique([providerId, providerProductCode])
}

model PackageRenewal {
  id              String  @id @default(uuid())
  packageId       String
  package         Package @relation(fields: [packageId], references: [id])
  targetPackageId String
  target          Package @relation("RenewalTarget", fields: [targetPackageId], references: [id])

  @@unique([packageId, targetPackageId])
}

model PackageSwitch {
  id              String  @id @default(uuid())
  packageId       String
  package         Package @relation(fields: [packageId], references: [id])
  targetPackageId String
  target          Package @relation("SwitchTarget", fields: [targetPackageId], references: [id])

  @@unique([packageId, targetPackageId])
}

// What one account may sell and at what price, written by its parent or the branch.
// `hidden` turns the package off for the account and everyone under it. A null price inherits.
model UserPackage {
  id           String   @id @default(uuid())
  packageId    String
  // CASCADE as the database has it since 20261030090000_package_sheet (then PackageOffer).
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hidden       Boolean  @default(false)
  price        Int?
  renewalPrice Int?
  setById      String   @default("")
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([packageId, userId])
}

// A main agent's or agent's default sell price to the accounts directly under it.
// The branch has none: its defaults are the Package columns.
model SellPrice {
  id           String  @id @default(uuid())
  packageId    String
  package      Package @relation(fields: [packageId], references: [id])
  ownerId      String
  owner        User    @relation(fields: [ownerId], references: [id])
  price        Int
  renewalPrice Int?

  @@unique([packageId, ownerId])
}

model Line {
  id            String       @id @default(uuid())
  msisdn        String       @unique
  iccid         String?
  esim          Boolean      @default(false)
  esimQr        String?
  status        String
  endsAt        DateTime
  opsLocked     Boolean      @default(false)
  originAgentId String?
  packageId     String
  package       Package      @relation(fields: [packageId], references: [id])
  posId         String
  pos           User         @relation("LinePos", fields: [posId], references: [id])
  terms         Json
  createdAt     DateTime     @default(now())
  tasks         OfficeTask[]

  @@index([posId, createdAt])
  @@index([status])
  @@index([packageId])
  @@index([iccid])
}

model OfficeTask {
  id            String           @id @default(uuid())
  action        String
  status        String
  posId         String
  packageId     String
  lineId        String?
  line          Line?            @relation(fields: [lineId], references: [id])
  submitterId   String
  submitter     User             @relation("TaskSubmitter", fields: [submitterId], references: [id])
  assigneeId    String?
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  posDelta      Int
  /** What opening this task held on the point of sale's wallet, released when it closes. */
  held          Int              @default(0)
  msisdn        String?
  iccid         String?
  esim          Boolean          @default(false)
  esimQr        String?
  nextPackageId String?
  note          String?
  resultNote    String?
  log           String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  notes         OfficeTaskNote[]

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
  // Tasks an account holds (freezing returns them).
  @@index([assigneeId, status])
}

model OfficeTaskNote {
  id        String     @id @default(uuid())
  taskId    String
  task      OfficeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  body      String
  /// Only branch accounts (the owner and the staff) read an internal note (spec 2026-11-09, 2).
  internal  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([taskId, createdAt])
}

model ActivityEvent {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLogin  String   @default("")
  actorLayer  String   @default("")
  action      String
  result      String
  reason      String   @default("")
  ip          String   @default("")
  subjectKind String   @default("")
  subjectRef  String   @default("")

  @@index([at])
  @@index([actorId, at])
  @@index([action, at])
}

model AccessLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  targetLogin String
  ip          String   @default("")
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
}

model Notice {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String
  payload   Json      @default("{}")
  actorId   String?
  actorName String    @default("")
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Office identity: one row (id = 1) the branch owner edits from /branding.
// Images are data URLs, the same storage as Company.image.
model SiteBranding {
  id        Int      @id @default(1)
  siteName  String   @default("")
  tagline   String   @default("")
  logo      String?
  logoDark  String?
  favicon   String?
  updatedAt DateTime @updatedAt
}

/** One comparison of a provider's statement with our operations (roadmap N8). */
model ProviderReconciliation {
  id             String               @id @default(uuid())
  providerId     String
  provider       Provider             @relation(fields: [providerId], references: [id])
  fileName       String
  periodFrom     DateTime?
  periodTo       DateTime?
  statementTotal Int
  ourTotal       Int
  /** How many rows fell in each class: matched, different, missing_ours, missing_theirs, duplicate. */
  counts         Json
  actorLogin     String
  createdAt      DateTime             @default(now())
  items          ProviderReconItem[]

  @@index([providerId, createdAt])
}

/** A row that did not match, followed until it is handled. */
model ProviderReconItem {
  id               String                 @id @default(uuid())
  reconciliationId String
  reconciliation   ProviderReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  kind             String
  msisdn           String
  at               DateTime?
  theirAmount      Int?
  ourAmount        Int?
  ourEntryId       String?
  reference        String?
  status           String                 @default("open")
  note             String?
  resolvedBy       String?
  resolvedAt       DateTime?

  @@index([reconciliationId])
}

/** A WebAuthn credential (roadmap N9): signs the user in without a password. */
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String    @default("")
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/** An extra operation named by hand for a package (spec 2026-11-09, 3): requested on a number, it becomes a manual task. */
model PackageAddon {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name      String
  /** What the point of sale pays, in agorot; 0 for a free one. */
  price     Int      @default(0)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([packageId, position])
}

/** An offer on the home hero (spec 2026-11-09, 1): a picture and text, for some layers, shown for `seconds`. */
model Offer {
  id          String    @id @default(uuid())
  title       String
  body        String    @default("")
  /** A data URL (png, jpeg or webp), at most about 700 KB. */
  image       String?
  actionLabel String?
  /** An office path starting with `/`, or an `https://` address. */
  actionHref  String?
  seconds     Int       @default(7)
  active      Boolean   @default(true)
  position    Int       @default(0)
  /** Comma-separated layers that see it: branch, main_agent, agent, pos. */
  layers      String    @default("branch,main_agent,agent,pos")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, position])
}
